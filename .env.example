# pcaptain settings. Copy to .env and edit; every value has a default, and an
# empty value means "use the default". This is the only place to configure a
# deployment: the backend reads these too (no config file to mount or edit).

# --- Where things are -------------------------------------------------------
# Folder on this machine with the pcap files to catalog (mounted read-only).
# It must exist: `docker compose up` stops with an error if it does not.
PCAP_DIRECTORIES=./pcaps

# --- Ports -----------------------------------------------------------------
# Web UI. This is the only port users need; the UI reaches the API through it.
FRONTEND_PORT=5000
# REST API published on the host, for scripts and curl (optional).
BE_BASE_PORT=7000
# The API has no authentication: by default only this machine can reach it.
# 0.0.0.0 publishes it on every network interface.
BE_BIND_ADDRESS=127.0.0.1
# Ports inside the compose network; change only if they clash with something.
BE_INTERNAL_PORT=7000
REDIS_INTERNAL_PORT=6379

# --- Images (for building on one machine and running on another) -----------
# docker compose build && docker compose push pushes <prefix>-backend:<tag>
# and <prefix>-frontend:<tag>; set the prefix to your registry/namespace.
IMAGE_PREFIX=pcaptain
IMAGE_TAG=latest

# --- Scanning ----------------------------------------------------------------
# fast (ports, quick) | quick (tshark on the first part of large files) | full (tshark, every packet).
# A change made later in the web UI is stored with the catalog and takes precedence.
SCAN_MODE=fast
# Automatic rescan interval in seconds.
PCAP_SCAN_INTERVAL_SECONDS=3600
MAX_PARALLEL_SCANS=4
# Files this big or bigger are "large"; LARGE_FILE_PARALLEL_SCANS of them are
# scanned at the same time (about 7 MB each in fast mode, 0.5 GB in full mode).
LARGE_FILE_SIZE=512M
LARGE_FILE_PARALLEL_SCANS=1
# tshark -M: reset dissector state every N packets to bound memory (0 = never).
TSHARK_SESSION_RESET=500000
# quick mode: tshark decodes only this share of each file at least
# QUICK_SCAN_MIN_FILE_SIZE big; bump QUICK_SCAN_CONFIG_VERSION to rescan them.
QUICK_SCAN_PEBC=0.1
QUICK_SCAN_MIN_FILE_SIZE=1024
QUICK_SCAN_CONFIG_VERSION=v1

# --- Filtered exports --------------------------------------------------------
EXPORT_CACHE_MAX_SIZE=5G
EXPORT_MAX_JOBS=2

# --- Misc ------------------------------------------------------------------
# Memory cap for the backend container (scans and exports run there).
BACKEND_MEMORY_LIMIT=4g
LOG_LEVEL=INFO
# Seconds the backend waits at startup for Redis to finish loading its data.
REDIS_WAIT_SECONDS=120
# Only if the UI must call a backend on another host (default: /api/ on the UI's own host).
BE_PUBLIC_URL=
# Prefix for download links returned by the API (default: relative links).
PUBLIC_URL=
