# Environment for Docker Compose


# Redis
REDIS_PORT=6380
REDIS_INTERNAL_PORT=6380
REDIS_HOST=redis
LOG_LEVEL=INFO

# BE
BE_BASE_PORT=7000
BE_INTERNAL_PORT=7000
PCAP_DIRECTORIES=./pcaps
PCAP_MOUNTED_DIRECTORY=/pcaps
BE_BASE_URL=localhost
# Address the browser uses to reach the API (written into the web UI's config.js)
BE_PUBLIC_URL=http://localhost:7000

# FE
FRONTEND_PORT=5000
NGINX_PORT=80